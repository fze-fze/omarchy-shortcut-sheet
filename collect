#!/usr/bin/env python3
"""Dump the focused window plus Hyprland bind records as JSON for the overlay."""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

MAX_COMMAND_OUTPUT_BYTES = 2 * 1024 * 1024
MAX_RECORD_BYTES = 2 * 1024 * 1024
MAX_RECORD_ROWS = 4096
MAX_KEY_CHARS = 256
MAX_LABEL_CHARS = 512
MAX_DISPATCHER_CHARS = 64
MAX_ARG_CHARS = 4096
MAX_CLASS_CHARS = 256
MAX_TITLE_CHARS = 1024
MAX_ADDRESS_CHARS = 128
MAX_TAGS = 64
MAX_TAG_CHARS = 256
ALLOWED_DISPATCHERS = {"", "exec", "lua", "sendshortcut"}


def run(cmd: list[str], max_bytes: int = MAX_COMMAND_OUTPUT_BYTES) -> str:
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        assert proc.stdout is not None
        output = proc.stdout.read(max_bytes + 1)
        if len(output) > max_bytes:
            proc.kill()
            proc.communicate()
            return ""
        return_code = proc.wait()
        if return_code != 0:
            return ""
        return output.decode("utf-8", errors="replace")
    except (OSError, subprocess.SubprocessError):
        return ""


def bounded(value: object, limit: int) -> str:
    text = str(value or "")
    return text if len(text) <= limit else text[:limit]


def active_window() -> dict:
    raw = run(["hyprctl", "activewindow", "-j"]).strip()
    if not raw or raw.lower().startswith("invalid"):
        return {}
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        return {}
    if not isinstance(data, dict):
        return {}
    raw_tags = data.get("tags")
    tags = raw_tags if isinstance(raw_tags, list) else []
    return {
        "class": bounded(data.get("class"), MAX_CLASS_CHARS),
        "initialClass": bounded(data.get("initialClass"), MAX_CLASS_CHARS),
        "title": bounded(data.get("title"), MAX_TITLE_CHARS),
        "address": bounded(data.get("address"), MAX_ADDRESS_CHARS),
        "tags": [bounded(tag, MAX_TAG_CHARS) for tag in tags[:MAX_TAGS]],
    }


def cache_dir() -> Path:
    return Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy"


def newest_records() -> Path | None:
    try:
        return max(cache_dir().glob("keybindings-*.records"), key=lambda path: path.stat().st_mtime, default=None)
    except OSError:
        return None


def ensure_records() -> Path | None:
    existing = newest_records()
    run(["omarchy-menu-keybindings", "--print"])
    refreshed = newest_records()
    if refreshed and refreshed.stat().st_size > 0:
        return refreshed
    return existing


def parse_records(path: Path) -> list[dict]:
    binds: list[dict] = []
    try:
        if path.stat().st_size > MAX_RECORD_BYTES:
            return binds
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return binds

    for line_number, line in enumerate(text.splitlines()):
        if line_number >= MAX_RECORD_ROWS:
            break
        if not line.strip():
            continue
        fields = line.split("\t")
        display = fields[0] if fields else ""
        dispatcher = fields[1] if len(fields) > 1 else ""
        arg = "\t".join(fields[2:]) if len(fields) > 2 else ""
        if " → " not in display:
            continue
        keys, label = display.split(" → ", 1)
        keys = " ".join(keys.split())
        label = label.strip()
        if (
            not keys
            or not label
            or len(keys) > MAX_KEY_CHARS
            or len(label) > MAX_LABEL_CHARS
            or len(dispatcher) > MAX_DISPATCHER_CHARS
            or len(arg) > MAX_ARG_CHARS
            or dispatcher not in ALLOWED_DISPATCHERS
        ):
            continue
        binds.append(
            {
                "keys": keys,
                "label": label,
                "dispatcher": dispatcher,
                "arg": arg,
            }
        )
    return binds


def main() -> int:
    records = ensure_records()
    payload = {
        "window": active_window(),
        "binds": parse_records(records) if records else [],
    }
    json.dump(payload, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
